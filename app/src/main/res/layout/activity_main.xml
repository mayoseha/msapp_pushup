<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <View
        android:id="@+id/touchArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCalendar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="달력"
                android:textColor="#FFB0B0B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLevel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="난이도"
                android:textColor="#FFB0B0B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGoal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="목표"
                android:textColor="#FFB0B0B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnReset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="초기화"
                android:textColor="#FFB0B0B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMusic"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="음악"
                android:textColor="#FFB0B0B0"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="오늘 목표 100개"
            android:textColor="@color/dim"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="중급 · 기본 자세"
            android:textColor="@color/accent"
            android:textSize="17sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="104sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOfGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="오늘 0 / 100"
            android:textColor="@color/dim"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvPct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="0%"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold" />

        <kr.haengwoon.pushup.GaugeView
            android:id="@+id/gauge"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/tvGhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/dim"
            android:textSize="19sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="화면에 코를 대었다 떼면 1회"
            android:textColor="#FF6A6A6A"
            android:textSize="15sp" />
    </LinearLayout>

    <kr.haengwoon.pushup.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
